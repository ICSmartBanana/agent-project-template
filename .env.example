# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
ANTHROPIC_API_KEY=

# Local Postgres (dev only). Any random strings will do.
AGENT_OWNER_PASSWORD=
AGENT_APP_PASSWORD=
AGENT_INGEST_PASSWORD=
AGENT_DB_HOST=127.0.0.1
AGENT_DB_PORT=5433

# Langfuse Cloud (EU). Optional: tracing is skipped when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
